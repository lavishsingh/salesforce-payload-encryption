<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <calloutStatus>Enabled</calloutStatus>
    <endpoint>https://YOUR-ORG-B-DOMAIN.my.salesforce.com</endpoint>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <jwtIssuer>YOUR_CONNECTED_APP_CONSUMER_KEY</jwtIssuer>
    <jwtAudience>"https://login.salesforce.com"</jwtAudience>
    <jwtTextSubject>YOUR_ORG_B_USERNAME</jwtTextSubject>
    <jwtSigningCertificate>OrgA_Signing_Cert</jwtSigningCertificate>
    <jwtValidityPeriodSeconds>180</jwtValidityPeriodSeconds>
    <label>OrgB JWT Legacy</label>
    <principalType>NamedUser</principalType>
    <protocol>Jwt</protocol>
</NamedCredential>
